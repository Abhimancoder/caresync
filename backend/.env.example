# Server Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Cloud Scheduler Secret for Cron Job Security
CRON_SECRET=caresync-cloud-scheduler-secret-2026

# Firebase Admin Configuration
# In production on Cloud Run, Google Application Default Credentials (ADC) are automatically picked up.
# For local development with a real Firebase project:
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# SMTP Email Configuration (Nodemailer)
# If left empty, CareSync automatically runs in "Development Simulation Mode"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CareSync Health <no-reply@caresync.health>"
